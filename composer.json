{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nunomaduro/laravel-starter-kit-inertia-react",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5.0",
        "inertiajs/inertia-laravel": "^3.5.1",
        "intervention/image": "^4.3.5",
        "laravel/ai": "^1.2.3",
        "laravel/framework": "^13.36.0",
        "laravel/octane": "^2.22",
        "laravel/socialite": "^5.31.0",
        "laravel/wayfinder": "^0.1.21",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "nunomaduro/essentials": "^1.2.0",
        "phpseclib/phpseclib": "^4.0.2",
        "tempest/highlight": "^2.28.1"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6.2",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.13.0",
        "laravel/boost": "^2.10.3",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/tinker": "^3.0.2",
        "laravel/vet": "^0.2.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.2",
        "pestphp/pest-plugin-browser": "^5.1.2",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "rector/rector": "^2.7.0",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "bun install",
            "bun run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@update:requirements"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "update:requirements": [
            "composer bump",
            "bunx npm-check-updates -u"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "bun run lint"
        ],
        "test:type-coverage": "pest --type-coverage --min=100 --memory-limit=-1",
        "test:lint": [
            "@php -d memory_limit=-1 vendor/bin/pint --parallel --test",
            "rector --dry-run --memory-limit=-1",
            "bun run test:lint"
        ],
        "test:unit": [
            "@putenv XDEBUG_MODE=coverage",
            "@php -d memory_limit=-1 vendor/bin/pest --parallel --coverage --exactly=100.0 --passthru-php=\"'-d' 'memory_limit=-1'\"",
            "bun run test:unit"
        ],
        "test:types": [
            "phpstan --memory-limit=-1",
            "bun run test:types"
        ],
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "laravel/vet": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
